<?xml version="1.0" encoding="utf-8"?>
<!-- Нейтральный (не акцентный) фон для кнопок/спиннеров в настройках —
раньше activity_settings.xml ссылался на @drawable/btn_neutral, а
самого файла в проекте не было (сборка падала на этом ресурсе).
Стиль подобран под остальные полупрозрачные элементы того же экрана
(rgba(255,255,255,0.06) фон / rgba(255,255,255,0.12) рамка — тот же
паттерн, что у returnToLibraryBtn/openSystemTtsSettingsBtn в
reader.html), чтобы не выбиваться визуально.

Подсветка при нажатии (state_pressed) убрана намеренно — при тапе
никакого визуального отклика быть не должно. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="#0FFFFFFF" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
