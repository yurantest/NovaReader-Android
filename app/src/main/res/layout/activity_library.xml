<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/libraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/library_header_bg"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Библиотека"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnLibraryBackup"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#xE864;"
                android:textColor="#CCCCCC"
                android:textSize="24sp"
                android:fontFamily="@font/material_icons_regular"
                android:contentDescription="Создать резервную копию"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/btnLibraryRestore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#xE8B3;"
                android:textColor="#CCCCCC"
                android:textSize="24sp"
                android:fontFamily="@font/material_icons_regular"
                android:contentDescription="Восстановить из резервной копии"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/btnLibrarySearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#xE8B6;"
                android:textColor="#CCCCCC"
                android:textSize="24sp"
                android:fontFamily="@font/material_icons_regular"
                android:contentDescription="Поиск книг"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/btnLibrarySettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#xE8B8;"
                android:textColor="#CCCCCC"
                android:textSize="25sp"
                android:fontFamily="@font/material_icons_regular"
                android:contentDescription="Настройки библиотеки"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="#2C2C2E"
            android:visibility="gone">
            <TextView
                android:id="@+id/btnCancelSelection"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#xE5CD;"
                android:textColor="#CCCCCC"
                android:textSize="24sp"
                android:fontFamily="@font/material_icons_regular"
                android:contentDescription="Отмена" />
            <TextView
                android:id="@+id/selectionCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Выбрано: 0"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/btnDeleteSelected"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#xE872;"
                android:textColor="#FF6B6B"
                android:textSize="24sp"
                android:fontFamily="@font/material_icons_regular"
                android:contentDescription="Удалить" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/libraryControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:background="@drawable/btn_neutral"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <TextView
                    android:id="@+id/searchBooksIcon"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="&#xE8B6;"
                    android:textColor="#8D8F97"
                    android:textSize="20sp"
                    android:fontFamily="@font/material_icons_regular" />
                <EditText
                    android:id="@+id/searchBooksEdit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Поиск по названию"
                    android:textColor="#F4F4F5"
                    android:textColorHint="#777981"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/formatFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/sortBooksButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="end"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Сортировка: последние открытые  ▾"
                android:textColor="#9D9FA7"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyLibraryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Пока нет ни одной книги.
Нажмите «+», чтобы добавить."
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/booksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="8dp" />
    </LinearLayout>
</FrameLayout>
