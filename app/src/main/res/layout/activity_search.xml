<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E">

    <LinearLayout
        android:id="@+id/searchHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:background="#2C2C2E">

        <TextView
            android:id="@+id/btnSearchBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="&#xE5C4;"
            android:textColor="#CCCCCC"
            android:textSize="24sp"
            android:fontFamily="@font/material_icons_regular"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад" />

        <TextView
            android:id="@+id/searchTitleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Поиск книг"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSearchHelp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="&#xE887;"
            android:textColor="#CCCCCC"
            android:textSize="22sp"
            android:fontFamily="@font/material_icons_regular"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Справка" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/searchQueryEdit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Название или автор…"
            android:textColorHint="#777781"
            android:textColor="#E8EAED"
            android:background="#2C2C2E"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnDoSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="&#xE8B6;"
            android:textColor="#5A4FCF"
            android:textSize="24sp"
            android:fontFamily="@font/material_icons_regular"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Найти" />

        <TextView
            android:id="@+id/btnStopSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="&#xE047;"
            android:textColor="#E74C3C"
            android:textSize="22sp"
            android:fontFamily="@font/material_icons_regular"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:enabled="false"
            android:alpha="0.4"
            android:contentDescription="Остановить" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/chkAuthorToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Author.Today"
                android:checked="true"
                android:textColor="#E8EAED"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/chkSearchFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Цокольный"
                android:checked="true"
                android:textColor="#E8EAED"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/chkMoreKnig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MoreKnig"
                android:checked="true"
                android:textColor="#E8EAED"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/chkFlibusta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Флибуста"
                android:checked="true"
                android:textColor="#E8EAED"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/searchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Введите запрос и нажмите «Найти»"
        android:textColor="#9AA0A6"
        android:textSize="13sp"
        android:background="#252528" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchResultsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
