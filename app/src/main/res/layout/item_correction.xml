<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:padding="6dp"
              android:layout_margin="4dp"
              android:gravity="center_vertical">

    <EditText
        android:id="@+id/corrWrong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Неправильно"
        android:textColor="#F4F4F5"
        android:textColorHint="#777981"
        android:textSize="13sp"
        android:inputType="text"
        android:singleLine="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/corrCorrect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:hint="Правильно"
        android:textColor="#F4F4F5"
        android:textColorHint="#777981"
        android:textSize="13sp"
        android:inputType="text"
        android:singleLine="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <CheckBox
        android:id="@+id/corrCase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:contentDescription="Без учёта регистра" />

    <TextView
        android:id="@+id/corrDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:text="&#xE872;"
        android:textSize="20sp"
        android:fontFamily="@font/material_icons_regular"
        android:contentDescription="Удалить строку"
        android:clickable="true"
        android:focusable="true" />
    </LinearLayout>
